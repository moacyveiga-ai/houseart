# HouseArt — environment variables (copy to .env; never commit real values).
# Every env the runtime reads has a line here (ratchet lib/architecture/env.test.ts).

# ── database ──────────────────────────────────────────────────────────────
# Dev: native Postgres on 5436 (`npm run db:up:native`). Prod: Supabase pooler (6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/houseart
# Integration tests TRUNCATE this database between tests — never the dev one.
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5436/houseart_test

# ── seed admin (`npm run db:seed`) ────────────────────────────────────────
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
ADMIN_CPF=00000000191

# ── app ───────────────────────────────────────────────────────────────────
# Public URL (links in e-mails, OAuth callbacks). Without it no public link is built.
# APP_URL=https://www.houseart.com.br
# NEXT_PUBLIC_APP_URL=
# Fixed timezone of the house is America/Bahia; override only in tests.
# TZ_OVERRIDE=
# Optional POST of server errors (lib/observability).
# ERROR_REPORT_WEBHOOK_URL=

# ── feature flags (lib/flags.ts; '1' turns on unless noted) ───────────────
# born ON; 0 turns off
# FLAG_TENANT_SCOPE=1
# FLAG_MEMBER_APP=
# FLAG_COLLECTOR_APP=
# FLAG_CONSIGNMENT_REQUIRED=
# FLAG_DEALS=
# FLAG_PHYSICAL_MARKERS=
# FLAG_CERTIFICATES=
# FLAG_OWNERSHIP_TRANSFER=
# FLAG_KYC_REQUIRED=
# FLAG_RESALE_ROYALTY=
# FLAG_DUPLICATE_DETECTION=
# FLAG_DOCUMENT_READING=
# FLAG_PROVENANCE_REPORT=
# 'true' turns on (paid cron)
# FLAG_PROVENANCE_CHECKS_AUTO=
# 'on' turns on
# FLAG_PROVENANCE_CONSENT_REQUIRED=
# FLAG_ORDERS=
# FLAG_PLANS=
# FLAG_COMMISSION=
# FLAG_BILLING=
# FLAG_ESCROW=
# FLAG_LOGISTICS=
# FLAG_APPRAISAL=
# FLAG_WHATSAPP_EVOLUTION=
# FLAG_WHATSAPP_BUSINESS_SIGNUP=
# FLAG_META_PER_MEMBER=
# FLAG_PUBLIC_API=
# FLAG_RBAC_SHADOW=
# FLAG_RBAC=
# FLAG_RBAC_SOURCE_ROLES=
# FLAG_FEDERATED_PROVISIONING=

# Bearer of the cron/job routes (Vercel Cron sends it); production without it refuses every run.
# CRON_SECRET=

# ── storage ───────────────────────────────────────────────────────────────
# Vercel Blob PUBLIC store (derivatives). Without it, dev writes to public/uploads.
# BLOB_READ_WRITE_TOKEN=
# Vercel Blob PRIVATE store (masters, personal documents). Without it on Vercel: 503. Dev: ./.vault
# BLOB_PRIVATE_READ_WRITE_TOKEN=
# Name the Vercel dashboard generates when the store is connected with the prefix BLOB_PRIVATE_READ_WRITE_TOKEN (accepted as an alias).
# BLOB_PRIVATE_READ_WRITE_TOKEN_READ_WRITE_TOKEN=
# Without BLOB_READ_WRITE_TOKEN the derivatives live in the private store and are served at /api/public/media/.

# ── secrets of the document cipher (openssl rand -base64 32) ──────────────
# "id:base64[,id2:base64]" — first = active; required in production.
# DOCUMENT_CIPHER_KEYS=
# HMAC pepper of the search hashes; required in production.
# DOCUMENT_HASH_PEPPER=

# ── e-mail ────────────────────────────────────────────────────────────────
# smtp://user:pass@host:587 — without it the message is logged (dev/CI).
# SMTP_URL=
# Sender shown to the recipient (default "HouseArt <no-reply@houseart.com.br>").
# SMTP_FROM=
# Dev only: EMAIL_ECHO=1 prints the full message (codes) to the console.
# EMAIL_ECHO=

# ── access (handoff Fase 2): SMS, social login, password reset ────────────
# twilio | mock — mock logs the SMS without the code (dev/CI/production without a contract).
# SMS_PROVIDER=
# Dev only: SMS_ECHO=1 prints the SMS text (code) to the console.
# SMS_ECHO=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender number in E.164 (+55…).
# TWILIO_FROM=
# Dev/smoke only: AUTH_CODE_ECHO=1 returns the e-mail/SMS code in the start response. Never on Vercel production.
# AUTH_CODE_ECHO=
# Social login: a provider only appears when BOTH values exist. Redirect URI: <APP_URL>/api/auth/oauth/<provider>/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# Apple: the client secret is the signed JWT (ES256) generated from the key of the Services ID; rotate before it expires (6 months).
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_LINKEDIN_CLIENT_ID=
# OAUTH_LINKEDIN_CLIENT_SECRET=
# Dev/CI only: OAUTH_MOCK=1 offers a simulated provider (a local page that returns any e-mail). Never in production.
# OAUTH_MOCK=

# ── assisted reading of the artwork photos (handoff Fase 3) ────────────────
# claude | mock — claude sends front/signature/back to the model and fills the EMPTY sheet fields (paid call, 5/obra/dia); anything else = no call.
# ARTWORK_READING_MODE=
# ANTHROPIC_API_KEY=

# ── certificates and markers ──────────────────────────────────────────────
# Ed25519 seed of the issuer key, base64 of 32 bytes (openssl rand -base64 32); required in production.
# CERTIFICATE_SIGNING_SEED=
# ntag424 | mock (mock = derived dev master key; the app/tests produce valid SUN messages).
# MARKER_VENDOR=
# The 16-byte master key (base64) when MARKER_VENDOR=ntag424 (HSM/KMS later).
# MARKER_MASTER_KEY=
# none | opentimestamps (only the merkle root is stored in the MVP).
# ANCHOR_NETWORK=

# ── deals, transfers and KYC (Phase 4) ────────────────────────────────────
# mock | test | live — the Stripe mode (lib/stripe/mode-core.ts). test needs an sk_test_ key, live an sk_live_ key;
# anything else (or no key) is the mock: every charge paid on the spot with a mock_ reference (dev/tests).
# STRIPE_ENV=
# mock | (provider slug) — mock approves the identity check on the spot (MVP).
# KYC_PROVIDER=

# ── billing (Phase 5) ─────────────────────────────────────────────────────
# Stripe secret key: sk_test_… with STRIPE_ENV=test, sk_live_… with STRIPE_ENV=live; without it every charge is the mock.
# STRIPE_SECRET_KEY=
# Stripe publishable key for Stripe.js/Elements (card form): pk_test_… in test, pk_live_… in live. Without it the
# screens keep the mock card form (and saving a card is refused in test/live).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret (whsec_…) of the webhook endpoint /api/stripe/webhook; without it the webhook answers 503.
# STRIPE_WEBHOOK_SECRET=
# 1 lets the Stripe mock run in a production deployment (previews, smoke); never in the real production.
# STRIPE_MOCK_ALLOWED=
# 1 lets STRIPE_ENV=test run in the real production (VERCEL_ENV=production) — the pilot with Stripe test cards.
# STRIPE_TEST_ALLOWED=

# ── smoke (Playwright) ────────────────────────────────────────────────────
# Base URL of the running build the smoke suite targets (default http://localhost:3019).
# SMOKE_BASE_URL=
# 1 skips the journeys that write (against a deployment).
# SMOKE_READONLY=
# Credentials of the member/admin the journeys log in as (defaults = dev seed).
# SMOKE_ARTIST_EMAIL=
# SMOKE_ARTIST_PASSWORD=
# SMOKE_ADMIN_EMAIL=
# SMOKE_ADMIN_PASSWORD=
# Path of a preinstalled Chromium (sandboxes/CI without `playwright install`).
# PLAYWRIGHT_CHROMIUM_PATH=

# Web push (handoff Fase 5): the three together turn push on; `npx web-push generate-vapid-keys`.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:contato@houseart.com.br

# Expo Push for the mobile apps (optional; without it the public door of exp.host is used).
# EXPO_ACCESS_TOKEN=
