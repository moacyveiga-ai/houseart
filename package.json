{
  "name": "houseart",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev -p ${PORT:-3008}",
    "dev:3019": "PORT=3019 npm run dev",
    "app:web": "cd apps/mobile && npx expo export -p web --output-dir ../../public/app",
    "build": "npm run migrate:deploy:ci && npm run build:next",
    "build:next": "tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "gate": "npm run lint && npm run typecheck && npm test && npm run schema:diff",
    "schema:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "migrate:deploy:ci": "if [ \"$VERCEL_ENV\" = \"production\" ]; then node scripts/migrate-deploy.mjs; elif [ -n \"$VERCEL\" ]; then npx prisma generate; fi",
    "db:up:native": "node scripts/db-native.mjs up",
    "db:down:native": "node scripts/db-native.mjs down",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "node scripts/db-prepare.mjs --migrate-test",
    "db:seed": "npx tsx scripts/seed-admin.ts",
    "smoke": "playwright test -c e2e/playwright.config.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.2.6",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
