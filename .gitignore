# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# cofre local dos documentos pessoais (dev/teste; lib/storage/private-vault.ts)
/.vault
# razão das cópias da migração para o cofre (guarda URLs públicas: sensível)
/vault-migration-ledger*.jsonl

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# resquício do SQLite de dev (extinto em 2026-09-06; o banco de dev é o Docker)
*.db
*.db-journal
*.db-wal
*.db-shm

# uploads locais
/public/uploads/*
!/public/uploads/.gitkeep

# logs
nohup.out

# Postgres embutido (npm run db:up:native) — cluster local, nunca versionado
/.pgdata
/.pgdata.log

# Playwright (suíte de smoke)
/test-results/
/playwright-report/

# prisma client (generated)
/app/generated
# native dev postgres cluster
/.pgdata
/.pgdata.log
