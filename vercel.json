{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "ignoreCommand": "bash -c '[ \"$VERCEL_ENV\" != \"production\" ]'",
  "crons": [
    {
      "path": "/api/cron/certificate-anchor",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/offers-expire",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/connect-payouts",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/market-indicators",
      "schedule": "5 * * * *"
    }
  ]
}
