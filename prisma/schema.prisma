// HouseArt — the ONE Prisma schema, Postgres in every environment.
// Conventions (HOUSEART_BUILD.md §A.2): Int ids; String + allowlist in code
// (no enum/Json/String[]); money as BigInt cents (`*Cents`); bps as Int; PII
// only as *Enc/*Hash/*Mask; tenantId derived by Postgres trigger (ha_tenant_*).
// Every schema change comes WITH an additive, reexecutable migration in
// prisma/migrations. NEVER `db push`: partial unique indexes and triggers live
// only in the migrations.
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant: PERSON (artist, advisor, collector with a plan) or GALLERY.
model Tenant {
  id             Int                @id @default(autoincrement())
  kind           String // PERSON | GALLERY
  name           String
  document       String?            @unique // digits only (CPF/CNPJ)
  slug           String             @unique
  status         String             @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  users          User[]
  members        Member[]
  subscriptions  PlanSubscription[]
  galleryProfile GalleryProfile?
  publicProfile  GalleryPublicProfile?

  @@index([status])
}

/// Login. `profile` is the legacy-style allowlist (lib/auth/profiles.ts);
/// `UserProfile` (Phase 1) holds the product profiles the person can switch to.
model User {
  id                   Int           @id @default(autoincrement())
  email                String        @unique
  cpf                  String?       @unique
  name                 String
  passwordHash         String?
  profile              String // admin | manager | operator | finance | member | appraiser | collector
  active               Boolean       @default(true)
  memberId             Int?          @unique
  tenantId             Int?
  tenant               Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantRole           String? // ADMIN | MEMBER
  authProviderId       String?       @unique
  phone                String? // E.164 (+55…), verified by SMS code
  phoneVerifiedAt      DateTime?
  emailVerifiedAt      DateTime?
  termsAcceptedAt      DateTime?
  marketingOptIn       Boolean       @default(false)
  preferencesJson      String        @default("{}") // onboarding: uses, interests, city
  recoverySessionId    String?
  recoverySessionUntil DateTime?
  collectorVerifiedAt  DateTime?
  deletionRequestedAt  DateTime?
  lastLoginAt          DateTime?
  stripeCustomerId     String? // Stripe Customer (cus_…) of the payer; created on the first saved card (test/live)
  stripeCustomerMode   String? // test | live — a customer of one mode does not exist in the other
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  sessions             Session[]
  profiles             UserProfile[]
  member               Member?
  auditLogs            AuditLog[]
  identities           UserIdentity[]

  @@index([tenantId])
  @@index([profile, active])
}

/// Product profiles the person can switch to (screen "Escolha de perfil").
model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // ARTIST | GALLERY | ADVISOR | COLLECTOR | APPRAISER | STAFF
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, kind])
}

/// Panel session (cookie `houseart_session`). `token` stores `h1:` + sha256.
model Session {
  id                Int       @id @default(autoincrement())
  token             String    @unique
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  /// the product profile active in this session (lib/profiles)
  activeProfileKind String?
  ip                String?
  userAgent         String?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One-time codes by e-mail: SIGNUP (payload of the account to create), LOGIN, SILENT (blind response).
model AccessCode {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique
  purpose      String // SIGNUP | LOGIN | SILENT | PHONE | RESET
  email        String
  channel      String    @default("EMAIL") // EMAIL | SMS
  phone        String? // E.164, for PHONE
  userId       Int? // the logged user who verifies a phone
  codeHash     String
  attempts     Int       @default(0)
  resends      Int       @default(0)
  blockedUntil DateTime?
  payloadEnc   String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  String
  action    String
  before    String?
  after     String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  ip        String?
  userAgent String?
  origin    String   @default("ui") // ui | api | job | webhook | public-link
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model RateLimitBucket {
  key             String    @id
  count           Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
  @@map("rate_limit_bucket")
}

/// Commercial profile of a user (artist, gallery staff, advisor). HOT model.
model Member {
  id          Int       @id @default(autoincrement())
  userId      Int?      @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  kind        String // ARTIST | GALLERY_STAFF | ADVISOR | COLLECTOR (the collector who registers or resells own artworks)
  displayName String
  slug        String    @unique
  city        String?
  uf          String?
  status      String    @default("ACTIVE") // PENDING | ACTIVE | REFUSED | INACTIVE
  role        String? // gallery staff: ADMIN | SALES | INVENTORY (Phase 6)
  approvedAt  DateTime?
  bio         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  artist      Artist?
  artworks    Artwork[]

  @@index([tenantId, status])
}

/// The artist of an artwork — with an account (memberId) or represented by a gallery (tenantId).
model Artist {
  id          Int                   @id @default(autoincrement())
  memberId    Int?                  @unique
  member      Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  tenantId    Int?
  name        String
  slug        String                @unique
  birthYear   Int?
  deathYear   Int?
  heirsJson   String                @default("[]")
  verifiedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  artworks    Artwork[]
  comparables AppraisalComparable[]
  profile     ArtistProfile?
  entries     ArtistEntry[]
  publications Publication[]

  @@index([tenantId])
}

model GalleryProfile {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalName   String
  tradeName   String
  cnpjEnc     String?
  cnpjHash    String?
  cnpjMask    String?
  addressJson String   @default("{}")
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The artwork (technical sheet). HOT model; tenantId derived by trigger ha_tenant_from_member_id.
model Artwork {
  id                Int                      @id @default(autoincrement())
  tenantId          Int?
  memberId          Int
  member            Member                   @relation(fields: [memberId], references: [id])
  artistId          Int
  artist            Artist                   @relation(fields: [artistId], references: [id])
  title             String
  year              Int?
  technique         String?
  materials         String?
  heightMm          Int?
  widthMm           Int?
  depthMm           Int?
  edition           String?
  signatureLocation String?
  series            String?
  category          String                   @default("PAINTING") // PAINTING | SCULPTURE | PHOTOGRAPHY | LITERATURE | PRINT | DRAWING | MIXED_MEDIA (lib/artworks/domain.ts)
  conditionGrade    String? // EXCELLENT | GOOD | FAIR | NEEDS_RESTORATION
  conditionBy       String?
  conditionAt       DateTime?
  status            String                   @default("DRAFT") // ARTWORK_STATUSES
  market            String? // PRIMARY | SECONDARY
  saleMode          String? // FIXED | FIXED_WITH_OFFERS | ON_REQUEST
  listPriceCents    BigInt?
  priceSealed       Boolean                  @default(false)
  // Collector-registered artwork (decision 2026-10-22): where it came from. ACQUISITION_KINDS in lib/artworks/domain.
  acquisitionKind       String?
  acquisitionYear       Int?
  acquisitionFrom       String?
  acquisitionNote       String?
  acquisitionPriceCents BigInt?
  publicId          String?                  @unique
  seal              String                   @default("NONE") // NONE | YELLOW | GREEN
  sealIssuedAt      DateTime?
  coverMediaId      Int?
  listingPausedAt   DateTime? // Phase 6: paused listing stays LISTED but leaves the marketplace
  wizardStep        Int                      @default(0)
  submittedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  media             ArtworkMedia[]
  conditionRegions  ArtworkConditionRegion[]
  historyItems      ArtworkHistoryItem[]
  owners            ArtworkOwner[]
  duplicateChecks   DuplicateCheck[]         @relation("DuplicateCheckArtwork")
  duplicateOf       DuplicateCheck[]         @relation("DuplicateCheckCandidate")
  certificate       Certificate?
  mandates          Mandate[]
  offers            Offer[]
  opportunities     Opportunity[]
  deals             Deal[]
  transfers         OwnershipTransfer[]
  royalties         RoyaltyPayment[]
  insurancePolicies InsurancePolicy[]
  appraisalRequests AppraisalRequest[]

  @@index([tenantId, status])
  @@index([memberId, status])
  @@index([artistId])
  @@index([status, createdAt])
}

/// The 6 fixed media slots of the "Mídia" step (+ DETAIL/OTHER).
model ArtworkMedia {
  id        Int      @id @default(autoincrement())
  artworkId Int
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  kind      String // FRONT_COLOR_CARD | BACK | MACRO_TL | MACRO_TR | MACRO_BL | MACRO_BR | DETAIL | OTHER
  masterRef String // private vault (original bytes)
  publicUrl String? // derivative ≤ 2048px
  sha256    String
  pHash     String?
  width     Int
  height    Int
  quality   String? // GOOD | BLURRY | PENDING
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([artworkId, kind])
}

model ArtworkConditionRegion {
  id        Int     @id @default(autoincrement())
  artworkId Int
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  region    String // TOP_LEFT | TOP_RIGHT | CENTER | BOTTOM_LEFT | EDGES_FRAME
  note      String  @default("")
  state     String  @default("INTACT") // INTACT | ATTENTION | DAMAGED

  @@unique([artworkId, region])
}

model ArtworkHistoryItem {
  id          Int     @id @default(autoincrement())
  artworkId   Int
  artwork     Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  kind        String // EXHIBITION | PUBLICATION | AWARD | RESTORATION | LOAN
  description String
  occurredOn  String // YYYY-MM
  sortOrder   Int     @default(0)
}

/// Owners at registration (shares sum 10000 bps). The certificate holder comes from ownership.
model ArtworkOwner {
  id           Int     @id @default(autoincrement())
  artworkId    Int
  artwork      Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  partyName    String
  documentHash String
  documentEnc  String
  documentMask String
  shareBps     Int     @default(10000)
  userId       Int?

  @@unique([artworkId, documentHash])
}

model DuplicateCheck {
  id                 Int       @id @default(autoincrement())
  artworkId          Int
  artwork            Artwork   @relation("DuplicateCheckArtwork", fields: [artworkId], references: [id], onDelete: Cascade)
  candidateArtworkId Int
  candidate          Artwork   @relation("DuplicateCheckCandidate", fields: [candidateArtworkId], references: [id], onDelete: Cascade)
  similarityBps      Int
  method             String    @default("PHASH") // PHASH | EMBEDDING
  decision           String    @default("PENDING") // PENDING | DIFFERENT | SAME
  decidedByUserId    Int?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([artworkId, decision])
}

/// Certificate-deed of an artwork (Phase 2 fills versions/events). HOT model.
model Certificate {
  id                Int                  @id @default(autoincrement())
  artworkId         Int                  @unique
  artwork           Artwork              @relation(fields: [artworkId], references: [id])
  publicId          String?              @unique
  currentVersionId  Int?
  status            String               @default("DRAFT") // DRAFT | ACTIVE | CONTESTED | REVOKED
  stage             Int                  @default(0) // 0..5
  signedAt          DateTime?
  signedByUserId    Int?
  signatureJson     String? // JWS of the issuer + evidence of the member's signature (ip, ua, time)
  timestampTokenRef String? // ACT ICP-Brasil (mock in the MVP)
  issuedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  versions          CertificateVersion[]
  events            CertificateEvent[]
}

model CertificateVersion {
  id                 Int         @id @default(autoincrement())
  certificateId      Int
  certificate        Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  version            Int
  holderName         String
  holderDocumentHash String?
  holderDocumentMask String?
  holderUserId       Int?
  contentJson        String
  contentHash        String
  prevHash           String?
  signaturesJson     String      @default("[]")
  timestampTokenRef  String?
  issuedAt           DateTime    @default(now())
  pdfRef             String?
  pdfHash            String?
  status             String      @default("ACTIVE") // ACTIVE | SUPERSEDED

  @@unique([certificateId, version])
}

model CertificateEvent {
  id            Int         @id @default(autoincrement())
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  seq           Int
  kind          String // CREATED | CERTIFIED | LISTED | TRANSFERRED | LOANED | RESTORED | STOLEN | DISPUTED | INSURED
  payloadJson   String      @default("{}")
  hash          String
  prevHash      String?
  actorUserId   Int?
  occurredAt    DateTime    @default(now())
  anchorDay     String? // YYYY-MM-DD of the DailyAnchor that covers it

  @@unique([certificateId, seq])
  @@index([occurredAt])
}

model DailyAnchor {
  id         Int      @id @default(autoincrement())
  day        String   @unique // YYYY-MM-DD (house timezone)
  merkleRoot String
  network    String   @default("NONE") // NONE | OPENTIMESTAMPS | POLYGON
  txRef      String?
  eventCount Int
  createdAt  DateTime @default(now())
}

/// Batches of NFC markers imported from the vendor (Admin · Etiquetas).
model MarkerBatch {
  id          Int              @id @default(autoincrement())
  code        String           @unique // 2026-10
  quantity    Int
  destination String
  tenantId    Int?
  status      String           @default("NEW") // NEW | IN_USE | EXHAUSTED
  createdAt   DateTime         @default(now())
  markers     PhysicalMarker[]
}

model PhysicalMarker {
  id             Int          @id @default(autoincrement())
  batchId        Int
  batch          MarkerBatch  @relation(fields: [batchId], references: [id])
  uid            String       @unique // 7 bytes hex
  keyRef         String // reference of the diversified key; never the key
  status         String       @default("STOCK") // STOCK | SHIPPED | LINKED | REMOVED | REVOKED
  artworkId      Int?         @unique
  orderId        Int?
  linkedAt       DateTime?
  linkedByUserId Int?
  readCounter    Int          @default(0)
  lastReadAt     DateTime?
  reads          MarkerRead[]

  @@index([status])
  @@index([orderId])
}

model MarkerRead {
  id         Int            @id @default(autoincrement())
  markerId   Int
  marker     PhysicalMarker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  counter    Int
  cmacValid  Boolean
  tamperFlag Boolean        @default(false)
  ipHash     String?
  userId     Int?
  purpose    String // VERIFY | LINK | DELIVERY_CONFIRM | TRANSFER_CONFIRM
  createdAt  DateTime       @default(now())

  @@index([markerId, createdAt])
}

/// A member's kit order ("Pedir etiquetas · R$ 150"). `orderId` → Order (Phase 5), no FK.
model MarkerOrder {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  memberId       Int
  quantity       Int
  unitPriceCents BigInt    @default(1500)
  status         String    @default("REQUESTED") // REQUESTED | SHIPPED | DELIVERED
  orderId        Int?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([memberId, status])
  @@index([status])
}

/// Admin review queue (Admin · Obras e certificados).
model ReviewQueueItem {
  id              Int       @id @default(autoincrement())
  kind            String // DUPLICATE | CONTESTATION | NEW_ISSUER | MARKER_REMOVED | EXPORT_RESTRICTION
  artworkId       Int?
  tenantId        Int?
  reason          String
  refId           Int? // DuplicateCheck / MarkerRead id when relevant
  status          String    @default("OPEN") // OPEN | APPROVED | REJECTED
  decidedByUserId Int?
  decidedAt       DateTime?
  decisionNote    String? // reason written by the staff (required for the decisions that undo something)
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
  @@index([artworkId])
}

/// Job lease (lib/job-lease): one run at a time per job name.
model JobLease {
  name        String   @id
  /// the run that owns the lock (uuid); only it releases
  runId       String
  /// the lock expires on its own here (a run that died without releasing)
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

/// Sale mandate of a listed artwork. `reservePriceCents` (the floor) NEVER leaves the backend. HOT model.
model Mandate {
  id                Int      @id @default(autoincrement())
  artworkId         Int
  artwork           Artwork  @relation(fields: [artworkId], references: [id])
  memberId          Int
  tenantId          Int?
  listPriceCents    BigInt
  reservePriceCents BigInt
  fixedPrice        Boolean  @default(false)
  autoNegotiatorOn  Boolean  @default(false)
  autoAcceptMinBps  Int      @default(9200)
  acceptsTrade      Boolean  @default(false)
  shippingIncluded  Boolean  @default(false)
  status            String   @default("ACTIVE") // ACTIVE | SUPERSEDED | CLOSED
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  offers            Offer[]

  @@index([artworkId, status])
  @@index([memberId])
}

/// A proposal from a collector on an artwork. HOT model; tenantId from the seller member by trigger.
model Offer {
  id                  Int           @id @default(autoincrement())
  code                String        @unique // OFR-AAAA-NNNNNN
  artworkId           Int
  artwork             Artwork       @relation(fields: [artworkId], references: [id])
  mandateId           Int?
  mandate             Mandate?      @relation(fields: [mandateId], references: [id])
  sellerMemberId      Int
  memberId            Int // = sellerMemberId (the trigger reads memberId)
  tenantId            Int?
  buyerUserId         Int?
  buyerName           String
  buyerEmail          String
  buyerDocumentHash   String?
  buyerDocumentEnc    String?
  buyerDocumentMask   String?
  buyerKind           String        @default("COLLECTOR") // COLLECTOR | ADVISOR_FOR_CLIENT
  buyerCity           String?
  offeredCents        BigInt
  acceptedCents       BigInt?
  status              String        @default("AWAITING_OTP") // OFFER_STATUSES
  expiresAt           DateTime
  otpHash             String?
  otpAttempts         Int           @default(0)
  otpExpiresAt        DateTime?
  retractionTokenHash String?
  retractionIssuedAt  DateTime?
  origin              String        @default("MARKETPLACE") // MARKETPLACE | LINK | PANEL
  message             String?
  // Phase 4 (handoff): validity chosen by the buyer, guarantee method and the quote frozen at the offer.
  validityHours       Int           @default(168)
  guaranteeMethod     String        @default("NONE") // GUARANTEE_METHODS (lib/payment-methods/domain.ts)
  guaranteeRef        String? // provider reference of the hold/reserve (mock_hold_… in mock; pi_… in test/live)
  guaranteeStatus     String? // GUARANTEE_STATUSES of lib/stripe/mode-core.ts; null = mock or no hold
  paymentMethodId     Int?
  deliveryCep         String?
  shippingCents       BigInt        @default(0)
  insuranceCents      BigInt        @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  rounds              OfferRound[]
  events              OfferEvent[]
  opportunities       Opportunity[]
  deal                Deal?

  @@index([artworkId, status])
  @@index([memberId, status])
  @@index([tenantId, status])
  @@index([buyerEmail])
  @@index([status, expiresAt])
}

model OfferRound {
  id          Int      @id @default(autoincrement())
  offerId     Int
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  number      Int
  author      String // BUYER | SELLER | NEGOTIATOR
  amountCents BigInt
  message     String?
  createdAt   DateTime @default(now())

  @@unique([offerId, number])
}

model OfferEvent {
  id          Int      @id @default(autoincrement())
  offerId     Int
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  kind        String // CREATED | CONFIRMED | ACCEPTED | REFUSED | COUNTERED | BUYER_REPLIED | NEGOTIATOR_ACCEPTED | EXPIRED | RETRACTED | GUARANTEE_AUTHORIZED | GUARANTEE_CAPTURED | GUARANTEE_RELEASED | GUARANTEE_FAILED
  actorKind   String // BUYER | SELLER | NEGOTIATOR | STAFF | SYSTEM
  actorUserId Int?
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([offerId, createdAt])
}

/// CRM contact of a member/gallery (collector). HOT model; tenantId from the owner member by trigger.
model Contact {
  id                   Int           @id @default(autoincrement())
  memberId             Int // owner (the trigger reads memberId)
  tenantId             Int?
  name                 String
  email                String?
  phone                String?
  documentHash         String?
  city                 String?
  origin               String        @default("MANUAL") // MANUAL | MARKETPLACE | OFFER | INSTAGRAM | REFERRAL
  collectorProfileJson String        @default("{}")
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  opportunities        Opportunity[]

  @@unique([tenantId, email])
  @@index([memberId])
  @@index([tenantId, documentHash])
}

/// Opportunity on the Kanban (Interessados · Em conversa · Proposta · Fechado). HOT model.
model Opportunity {
  id             Int      @id @default(autoincrement())
  contactId      Int
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  memberId       Int // responsible (the trigger reads memberId)
  tenantId       Int?
  artworkId      Int?
  artwork        Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  offerId        Int?
  offer          Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  stage          String   @default("INTERESTED") // INTERESTED | IN_CONVERSATION | OFFER | CLOSED
  outcome        String? // WON | LOST
  interest       String?
  valueCents     BigInt?
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([memberId, stage])
  @@index([tenantId, stage])
  @@index([contactId])
}

/// In-app notification (bell). Audience by `userId`.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// The sale after the accepted offer: 6 phases + COMPLETED. HOT model; tenantId from the seller member.
model Deal {
  id                   Int                @id @default(autoincrement())
  code                 String             @unique // DL-AAAA-NNNNNN
  artworkId            Int
  artwork              Artwork            @relation(fields: [artworkId], references: [id])
  offerId              Int                @unique
  offer                Offer              @relation(fields: [offerId], references: [id])
  sellerMemberId       Int
  memberId             Int // = sellerMemberId (trigger)
  tenantId             Int?
  buyerUserId          Int
  market               String             @default("PRIMARY") // PRIMARY | SECONDARY
  amountCents          BigInt
  shippingCents        BigInt             @default(0)
  insuranceCents       BigInt             @default(0)
  phase                String             @default("OFFER_ACCEPTED") // DEAL_PHASES
  exceptionStatus      String? // CANCELLED | DISPUTE
  escrowPaymentRef     String?
  escrowPaidAt         DateTime?
  /// How the buyer paid (or is paying) the escrow: CARD | PIX | BOLETO (lib/payments/async-core.ts). Null = before 2026-10-26.
  escrowMethod         String?
  /// The Pix/boleto PaymentIntent awaiting payment (pi_… / mock_pix_…); the webhook settles the escrow by it.
  escrowPendingRef     String?
  /// When an unpaid Pix/boleto stops holding the artwork (the cron cancels the deal).
  escrowExpiresAt      DateTime?
  /// The buyer's instructions (QR, copia e cola, boleto line, PDF) — PaymentInstructions as JSON.
  escrowInstructionsJson String?
  sellerSignedAt       DateTime?
  buyerSignedAt        DateTime?
  carrierName          String?
  trackingCode         String?
  insurerName          String?
  policyRef            String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  deliveryMarkerReadId Int?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  phaseEvents          DealPhaseEvent[]
  splits               DealSplit[]
  transfer             OwnershipTransfer?
  royalty              RoyaltyPayment?

  @@index([memberId, phase])
  @@index([tenantId, phase])
  @@index([buyerUserId, phase])
  @@index([escrowPendingRef])
}

model DealPhaseEvent {
  id          Int      @id @default(autoincrement())
  dealId      Int
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  phase       String
  title       String
  description String?
  actorKind   String   @default("SYSTEM") // SELLER | BUYER | STAFF | SYSTEM
  occurredAt  DateTime @default(now())

  @@index([dealId, occurredAt])
}

/// Split of the deal amount ("Repartição dos valores"). Sum = amountCents.
model DealSplit {
  id          Int     @id @default(autoincrement())
  dealId      Int
  deal        Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  party       String // ARTIST | GALLERY | PLATFORM | ADVISOR | ARTIST_ROYALTY | SHIPPING | INSURANCE
  bps         Int
  amountCents BigInt
  status      String  @default("HELD") // HELD | RELEASED | PAID
  /// The Stripe transfer (tr_…) that paid the line — the column reserved for it since Phase 4 (no separate transferRef).
  payoutRef   String?
  transferredAt DateTime?
  /// The last Stripe error code when the transfer failed (never a message, never PII); cleared when it pays.
  payoutError String?
  /// Recorded failures: versions the idempotency key (Stripe replays a saved failure for 24 h under the same key).
  payoutAttempts Int    @default(0)

  @@index([dealId])
  @@index([status, party])
}

/// Change of holder: on-platform (dealId) or off-platform (fee R$ 199).
model OwnershipTransfer {
  id              Int       @id @default(autoincrement())
  certificateId   Int
  artworkId       Int
  artwork         Artwork   @relation(fields: [artworkId], references: [id])
  dealId          Int?      @unique
  deal            Deal?     @relation(fields: [dealId], references: [id])
  fromUserId      Int
  toUserId        Int?
  toName          String
  toEmail         String
  toDocumentHash  String?
  toDocumentEnc   String?
  toDocumentMask  String?
  priceCents      BigInt?
  priceSealed     Boolean   @default(false)
  sealedPriceHash String?
  royaltyCents    BigInt    @default(0)
  feeCents        BigInt    @default(0)
  status          String    @default("DRAFT") // DRAFT | INVITED | KYC_PENDING | SELLER_SIGNED | BUYER_SIGNED | SIGNED | FEE_PAID | AWAITING_TAP | COMPLETED | CANCELLED
  inviteTokenHash String?   @unique
  inviteIssuedAt  DateTime?
  kycStatus       String? // PENDING | APPROVED | REJECTED
  sellerSignedAt  DateTime?
  buyerSignedAt   DateTime?
  feePaidAt       DateTime?
  feePaymentRef   String?
  tapMarkerReadId Int?
  completedAt     DateTime?
  newVersionId    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@index([artworkId])
}

/// Resale royalty: 5 % of the appreciation, withheld in the split and paid to the artist.
model RoyaltyPayment {
  id                Int       @id @default(autoincrement())
  artworkId         Int
  artwork           Artwork   @relation(fields: [artworkId], references: [id])
  artistId          Int
  transferId        Int?
  dealId            Int?      @unique
  deal              Deal?     @relation(fields: [dealId], references: [id])
  saleCents         BigInt
  previousSaleCents BigInt
  appreciationCents BigInt
  royaltyCents      BigInt
  status            String    @default("PENDING") // PENDING | HELD | PAID
  paidAt            DateTime?
  receiptRef        String?
  createdAt         DateTime  @default(now())

  @@index([artistId, status])
}

model KycVerification {
  id                Int       @id @default(autoincrement())
  userId            Int
  provider          String    @default("mock")
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  documentHash      String?
  biometricScoreBps Int?
  pepHit            Boolean   @default(false)
  verifiedAt        DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, status])
}

model InsurancePolicy {
  id            Int      @id @default(autoincrement())
  artworkId     Int
  artwork       Artwork  @relation(fields: [artworkId], references: [id])
  kind          String // TRANSIT | COLLECTION
  insurer       String
  policyNumber  String
  validFrom     DateTime
  validUntil    DateTime
  coverageCents BigInt
  status        String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  createdAt     DateTime @default(now())

  @@index([artworkId, status])
}

// ── Phase 5: plans, orders, invoices and appraisals ──────────────────────────

/// Plan catalog (seeded by the migration; prices editable by staff).
model Plan {
  id            Int                @id @default(autoincrement())
  code          String             @unique // ARTIST_FREE | ARTIST_STUDIO | GALLERY | GALLERY_PRO | ADVISOR
  name          String
  description   String
  audience      String // ARTIST | GALLERY | ADVISOR
  priceCents    BigInt
  active        Boolean            @default(true)
  features      PlanFeature[]
  subscriptions PlanSubscription[]
}

/// A limit of the plan (`limit` null = unlimited).
model PlanFeature {
  id     Int    @id @default(autoincrement())
  planId Int
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    String // ARTWORKS | TAGS_INCLUDED | APPRAISALS_INCLUDED | CERTIFICATIONS_MONTH | VIEWING_ROOMS | SEATS
  limit  Int?

  @@unique([planId, key])
}

/// One live subscription per tenant (partial unique index `PlanSubscription_tenant_active_key`, migration only).
model PlanSubscription {
  id                   Int       @id @default(autoincrement())
  tenantId             Int
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId               Int
  plan                 Plan      @relation(fields: [planId], references: [id])
  status               String    @default("ACTIVE") // ACTIVE | CANCELLED | PAST_DUE
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, status])
}

/// Service catalog (SERVICE_CODES of lib/orders/domain.ts; seeded by the migration).
model ServiceCatalog {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
  priceCents  BigInt
  unit        String  @default("UNIT") // UNIT | WEEK | QUOTE
  active      Boolean @default(true)
}

/// An order of a catalog service (ORD-AAAA-NNNNNN), paid by Stripe (mock in dev).
model Order {
  id                 Int       @id @default(autoincrement())
  code               String    @unique
  tenantId           Int?
  memberId           Int?
  userId             Int? // the payer when a person (collector)
  payerKind          String // BUYER | SELLER | ARTIST | GALLERY | REQUESTER | OTHER
  serviceCode        String
  description        String
  quantity           Int       @default(1)
  amountCents        BigInt
  status             String    @default("OPEN") // OPEN | PAID | CANCELLED
  provider           String    @default("STRIPE")
  paymentRef         String?
  paidAt             DateTime?
  artworkId          Int?
  dealId             Int?
  appraisalRequestId Int?
  transferId         Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  invoice            Invoice?

  @@index([tenantId, status])
  @@index([userId])
}

/// A line of "Faturas e notas fiscais": plan charge, paid order or commission held in the split.
model Invoice {
  id                Int      @id @default(autoincrement())
  tenantId          Int?
  userId            Int?
  kind              String // PLAN | ORDER | COMMISSION
  date              DateTime @default(now())
  description       String
  amountCents       BigInt
  status            String // PAID | HELD_IN_SPLIT | OPEN | CANCELLED
  fiscalDocumentRef String?
  orderId           Int?     @unique
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dealId            Int?
  subscriptionId    Int?
  createdAt         DateTime @default(now())

  @@index([tenantId, date])
  @@index([userId, date])
}

/// The appraisal queue: who asked, for what, until when.
model AppraisalRequest {
  id                  Int        @id @default(autoincrement())
  artworkId           Int
  artwork             Artwork    @relation(fields: [artworkId], references: [id])
  tenantId            Int?
  memberId            Int?
  requestedByUserId   Int
  requesterLabel      String // Colecionador | Galeria | Artista | Seguradora | Consultor
  purpose             String // SALE | INSURANCE | INVENTORY | ESTATE | COLLATERAL
  dueOn               DateTime
  assignedAppraiserId Int?
  status              String     @default("QUEUED") // QUEUED | IN_PROGRESS | ISSUED | CANCELLED
  orderId             Int?       @unique
  appraisal           Appraisal?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status, dueOn])
  @@index([artworkId])
}

/// The signed valuation report (immutable once ISSUED; a new one supersedes).
model Appraisal {
  id               Int              @id @default(autoincrement())
  requestId        Int              @unique
  request          AppraisalRequest @relation(fields: [requestId], references: [id])
  artworkId        Int
  appraiserUserId  Int
  version          Int              @default(1)
  minCents         BigInt
  suggestedCents   BigInt
  maxCents         BigInt
  methodology      String
  comparablesJson  String           @default("[]")
  contentHash      String
  signatureJson    String?
  verificationCode String           @unique // HA-L-AAAA-XXXX
  pdfRef           String?
  pdfHash          String?
  signedAt         DateTime?
  issuedAt         DateTime?
  status           String           @default("DRAFT") // DRAFT | ISSUED | SUPERSEDED
  createdAt        DateTime         @default(now())

  @@index([artworkId])
}

/// A comparable sale of the artist (auction catalogs typed by hand, or platform sales mirrored here).
model AppraisalComparable {
  id          Int      @id @default(autoincrement())
  artistId    Int
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  appraisalId Int?
  label       String
  dimensions  String?
  technique   String?
  priceCents  BigInt
  soldOn      DateTime
  source      String // AUCTION | GALLERY | HOUSEART
  createdAt   DateTime @default(now())

  @@index([artistId, soldOn])
}

// ── Public content (handoff 2026-10-21, Fase 7: Artista, Galeria, Home) ───────
// What the public pages show beyond the artwork sheet: the artist's profile and
// curriculum, the gallery's public profile, the house news and the art agenda.
// All optional — a section with no rows is hidden by the page.

/// The public profile of an artist (the "Artista" page). One per Artist.
model ArtistProfile {
  id             Int      @id @default(autoincrement())
  artistId       Int      @unique
  artist         Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  fullName       String?
  birthPlace     String? // "Salvador/BA"
  deathPlace     String?
  livesIn        String? // "Salvador/BA"
  nationality    String?
  representation String? // gallery or estate that represents the artist
  estateName     String? // for a deceased artist: the institute / estate
  languagesJson  String   @default("[]") // ["Pintura", "Óleo sobre linho", …]
  quote          String?
  bio            String? // paragraphs separated by blank lines
  photoUrl       String?
  photoCredit    String?
  royaltyBps     Int?     // the resale royalty the artist receives (display only)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// A curriculum entry of an artist: trajectory, exhibitions, awards, education, public collections.
model ArtistEntry {
  id       Int     @id @default(autoincrement())
  artistId Int
  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  kind     String // TRAJECTORY | SOLO | GROUP | AWARD | EDUCATION | COLLECTION
  year     String // "2026", "c. 1985"
  title    String
  venue    String?
  city     String?
  sortOrder Int    @default(0)

  @@index([artistId, kind, sortOrder])
}

/// E-books, catalogues and essays about an artist or published by a gallery.
model Publication {
  id         Int      @id @default(autoincrement())
  artistId   Int?
  artist     Artist?  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tenantId   Int?     // the gallery that publishes
  kind       String // EBOOK | CATALOGUE | ESSAY | INTERVIEW | RAISONNE
  title      String
  meta       String? // "96 páginas · PDF e ePub"
  priceCents BigInt? // null = free
  action     String   @default("READ") // BUY | DOWNLOAD | READ
  url        String?
  coverUrl   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([artistId, sortOrder])
  @@index([tenantId, sortOrder])
}

/// The public face of a gallery (the "Galeria" page), on top of GalleryProfile (legal data).
model GalleryPublicProfile {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String   @unique
  name        String
  city        String?
  uf          String?
  foundedYear Int?
  summary     String? // one line for the Galerias list
  about       String? // paragraphs separated by blank lines
  tagsJson    String   @default("[]") // ["Contemporânea", "Pintura"]
  street      String?
  district    String?
  lat         Float?
  lng         Float?
  coverUrl    String?
  websiteUrl  String?
  instagram   String?
  email       String?
  phone       String?
  hours       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uf])
}

/// Milestones, team members, media (photos/videos) and virtual-tour rooms of a gallery.
model GalleryItem {
  id        Int     @id @default(autoincrement())
  tenantId  Int
  kind      String // MILESTONE | TEAM | PHOTO | VIDEO | ROOM
  title     String
  subtitle  String? // role of a team member · year of a milestone · caption
  url       String? // media URL / room image
  sortOrder Int     @default(0)

  @@index([tenantId, kind, sortOrder])
}

/// House news (the Home "Notícias" section). Edited by the staff.
model NewsArticle {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  category    String // Mercado | Feiras | Museus | Direito | Artistas | …
  title       String
  summary     String?
  body        String?
  imageUrl    String?
  sourceName  String?
  sourceUrl   String?
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

/// The art agenda of Brazil (fairs, exhibitions, openings, auctions).
model AgendaEvent {
  id        Int      @id @default(autoincrement())
  kind      String // FAIR | EXHIBITION | OPENING | AUCTION
  title     String
  venue     String
  city      String // "Salvador/BA"
  startsOn  String // YYYY-MM-DD
  endsOn    String? // YYYY-MM-DD
  period    String? // "Até 20 dez"
  url       String?
  tenantId  Int?    // the gallery that posted it
  createdAt DateTime @default(now())

  @@index([startsOn])
}

// ── Access (handoff 2026-10-21, Fase 2) ──────────────────────────────────────
/// A social identity (Google, Apple, Facebook, LinkedIn — or MOCK outside production) linked to a user.
model UserIdentity {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // GOOGLE | APPLE | FACEBOOK | LINKEDIN | MOCK
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// A saved card of a buyer (Phase 4). Only brand/last4/expiry live here; the PAN never
/// touches the server beyond the tokenization call (mock: a mock_pm_ reference).
model PaymentMethod {
  id          Int       @id @default(autoincrement())
  userId      Int
  kind        String    @default("CARD") // CARD
  brand       String // visa | mastercard | amex | elo | hipercard | other
  last4       String
  holderName  String
  expMonth    Int
  expYear     Int
  billingCep  String?
  providerRef String // provider token (Stripe pm_… in test/live; mock_pm_… in mock)
  providerMode String   @default("mock") // mock | test | live (STRIPE_MODES of lib/stripe/mode-core.ts): only cards of the current mode are usable
  isDefault   Boolean   @default(false)
  status      String    @default("ACTIVE") // ACTIVE | REMOVED
  createdAt   DateTime  @default(now())
  removedAt   DateTime?

  @@index([userId, status])
}

/// Where a seller (member) receives sales: a Pix key confirmed in the holder's name. One per member.
model PayoutAccount {
  id          Int      @id @default(autoincrement())
  memberId    Int      @unique
  tenantId    Int?
  kind        String   @default("PIX") // PIX
  pixKeyType  String // CPF | CNPJ | EMAIL | PHONE | RANDOM
  pixKeyEnc   String
  pixKeyMask  String
  holderName  String
  status      String   @default("ACTIVE") // ACTIVE | REMOVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

/// Stripe Connect Express account of a seller member (one per member; `mode` says which Stripe it lives in —
/// a test account is useless live, so a mode change creates a new one and overwrites the row).
model StripeConnectAccount {
  id               Int       @id @default(autoincrement())
  memberId         Int       @unique
  tenantId         Int?
  accountId        String    @unique // acct_…
  mode             String // test | live
  status           String    @default("PENDING") // CONNECT_ACCOUNT_STATUSES: PENDING | ONBOARDING | RESTRICTED | ENABLED | DISABLED
  chargesEnabled   Boolean   @default(false)
  payoutsEnabled   Boolean   @default(false)
  detailsSubmitted Boolean   @default(false)
  /// The requirement codes Stripe says are currently due (JSON array of strings, no PII).
  requirementsJson String    @default("[]")
  disabledReason   String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([status, mode])
}

/// Gallery-wide offer rules (Phase 6, "Regras de ofertas"): defaults for every mandate of the member/tenant.
model OfferRules {
  id              Int      @id @default(autoincrement())
  memberId        Int      @unique
  tenantId        Int?
  refuseLow       Boolean  @default(true)
  refuseBelowBps  Int      @default(7000) // offers under this share of the list price are refused with a gentle message
  autoAcceptOn    Boolean  @default(false)
  autoAcceptMinBps Int     @default(9500)
  responseHours   Int      @default(48) // 24 | 48 | 72
  notifyTeam      Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

/// Invitation to join a gallery's team (Phase 6). Token only as sha256; 7 days.
model TeamInvite {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  email           String
  role            String // ADMIN | SALES | INVENTORY
  tokenHash       String    @unique
  invitedByUserId Int
  status          String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, status])
}

/// The gallery's contract with a represented artist (Phase 6, "Artistas representados").
model ArtistContract {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  artistId   Int
  kind       String    @default("REPRESENTED") // REPRESENTED | CONSIGNMENT
  galleryBps Int       @default(5000) // the gallery's share of the net
  validUntil DateTime?
  status     String    @default("ACTIVE") // ACTIVE | ENDED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, artistId])
}

/// Public views of an artwork per day (Phase 6, listing stats). One row per artwork and day.
model ArtworkViewDay {
  id        Int    @id @default(autoincrement())
  artworkId Int
  day       String // YYYY-MM-DD in the house timezone
  count     Int    @default(0)

  @@unique([artworkId, day])
}

// ── Social (handoff 2026-10-21, Fase 5: mensagens, comunidade, avisos) ────────
// Conversations are between TWO users about an artwork (or free). Lines with
// `senderUserId` null are system lines (offer sent, accepted…). Text that
// carries a phone, e-mail, link or Pix key is refused before it is stored
// (lib/messaging/core.ts): contacts and payments only through the platform.

model Conversation {
  id            Int       @id @default(autoincrement())
  artworkId     Int?
  userAId       Int // the smaller user id of the pair
  userBId       Int // the larger user id of the pair
  lastMessageAt DateTime?
  lastPreview   String?
  createdAt     DateTime  @default(now())
  messages      Message[]
  participants  ConversationParticipant[]

  @@unique([userAId, userBId, artworkId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  lastReadAt     DateTime?
  unread         Int          @default(0)

  @@unique([conversationId, userId])
  @@index([userId, unread])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   Int? // null = system line
  kind           String       @default("TEXT") // TEXT | SYSTEM | OFFER | COUNTER
  body           String
  offerId        Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, id])
}

/// A community post by a member or a collector: photo, text, poll or event.
/// News (NewsArticle) and the agenda (AgendaEvent) enter the feed as they are.
model Post {
  id              Int       @id @default(autoincrement())
  authorUserId    Int
  authorMemberId  Int?
  tenantId        Int?
  kind            String // PHOTO | TEXT | POLL | EVENT
  body            String
  imageUrl        String?
  artworkId       Int?
  eventTitle      String?
  eventVenue      String?
  eventStartsOn   String? // YYYY-MM-DD
  eventStartsAt   String? // "19h"
  pollOptionsJson String? // ["Pintura","Fotografia"]
  likeCount       Int       @default(0)
  commentCount    Int       @default(0)
  saveCount       Int       @default(0)
  rsvpCount       Int       @default(0)
  hiddenAt        DateTime?
  createdAt       DateTime  @default(now())
  comments        PostComment[]
  votes           PollVote[]

  @@index([createdAt])
  @@index([authorUserId])
}

model PostComment {
  id           Int      @id @default(autoincrement())
  targetKind   String // POST | NEWS
  targetId     Int
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int?
  userId       Int
  body         String
  likeCount    Int      @default(0)
  hiddenAt     DateTime?
  createdAt    DateTime @default(now())

  @@index([targetKind, targetId, id])
}

/// Like / save / rsvp / follow / comment-like, one row per (user, target, kind).
model Reaction {
  id         Int      @id @default(autoincrement())
  userId     Int
  targetKind String // POST | NEWS | EVENT | COMMENT | MEMBER
  targetId   Int
  kind       String // LIKE | SAVE | RSVP | FOLLOW
  createdAt  DateTime @default(now())

  @@unique([userId, targetKind, targetId, kind])
  @@index([targetKind, targetId, kind])
}

model PollVote {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  optionIdx Int
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// A Stripe webhook event already processed (idempotency by the event id). Stores no payload.
model StripeEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  type        String
  livemode    Boolean  @default(false)
  objectId    String? // the PaymentIntent the event was about
  processedAt DateTime @default(now())
}

/// The header ticker (D.25/E.15): one row per series — USD_BRL, EUR_BRL (AwesomeAPI, PTAX as fallback)
/// and HA_INDEX (own index of the platform's sales, lib/market-indicators). Written by the cron
/// market-indicators; a failed fetch never erases the last good value. HA_INDEX without sales = valueMicros null.
model MarketQuote {
  key         String   @id // USD_BRL | EUR_BRL | HA_INDEX
  /// value × 1 000 000 (R$ per unit for currencies; points for the index)
  valueMicros BigInt?
  /// change in basis points (vs the previous close / the index a day before); null when unknown
  changeBps   Int?
  /// when the source says the value is from
  observedAt  DateTime?
  source      String // awesomeapi | bcb-ptax | platform
  updatedAt   DateTime @updatedAt
}

/// The person's own Instagram professional account (handoff "Instagram · conectar e postar"), one per user.
/// The token is a long-lived Instagram token (60 days), encrypted; it never leaves the server.
model InstagramConnection {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  mode           String // MOCK | LIVE
  igUserId       String
  handle         String // "@galerialadeira"
  accountType    String? // BUSINESS | MEDIA_CREATOR
  followers      Int?
  tokenEnc       String
  tokenExpiresAt DateTime?
  defaultOn      Boolean   @default(false)
  includeLink    Boolean   @default(true)
  tagArtist      Boolean   @default(true)
  status         String    @default("CONNECTED") // CONNECTED | ERROR
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tokenExpiresAt])
}

/// A community post sent to Instagram: one row per post. `code` is the short link in the caption that counts the visits.
model InstagramPublication {
  id           Int       @id @default(autoincrement())
  postId       Int       @unique
  userId       Int
  connectionId Int
  format       String // FEED | STORIES | BOTH
  status       String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  attempts     Int       @default(0)
  error        String?
  feedMediaId  String?
  storyMediaId String?
  feedContainerId  String? // saved BEFORE media_publish: a resend asks its status and never publishes twice
  storyContainerId String?
  code         String    @unique
  targetPath   String
  reach        Int       @default(0)
  clicks       Int       @default(0)
  publishedAt  DateTime?
  insightsAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

/// A delivery address of a person (handoff "Perfil · minha conta" › Endereços de entrega). The default one
/// pre-fills the CEP of the checkout. Personal data: only the owner reads it.
model ShippingAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String // "Casa", "Escritório"
  recipient  String
  cep        String // 8 digits
  street     String
  number     String
  complement String?
  district   String
  city       String
  uf         String // 2 letters
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
